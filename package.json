{
  "name": "aria",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build --workspace=packages/core",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace=packages/core",
    "typecheck": "tsc -b --noEmit && vitest --typecheck.only --run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
